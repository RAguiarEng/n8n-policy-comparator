    {
      "parameters": {
        "jsCode": "// Percorre TODOS os itens que chegaram neste lote\nfor (const item of $input.all()) {\n  let textoCompleto = \"\";\n  const resultados = item.json.ParsedResults;\n\n  // Verifica se existem resultados e junta o texto de cada página\n  if (resultados && Array.isArray(resultados)) {\n    for (const pagina of resultados) {\n      if (pagina.ParsedText) {\n        textoCompleto += pagina.ParsedText + \"\\n\\n\";\n      }\n    }\n  }\n\n  // Adiciona o texto extraído ao item atual. \n  // Isso preserva a \"memória\" do n8n sobre qual arquivo gerou este texto!\n  item.json.texto_extraido = textoCompleto.trim();\n}\n\n// Retorna todos os itens processados\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
