{
  "name": "GenAI Seguros - Upload de Apólices",
  "nodes": [
    {
      "parameters": {
        "formTitle": "GenAI Seguros - Upload de Apólice",
        "formDescription": "Envie os arquivos das apólices (PDF, PNG ou JPG) para processamento seguro.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Documento",
              "fieldType": "file",
              "requiredField": true,
              "multiselect": true
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "form-trigger",
      "name": "n8n Form Trigger"
    },
    {
      "parameters": {
        "jsCode": "const newItems = [];\n\nfor (const item of $input.all()) {\n  if (item.binary) {\n    for (const key of Object.keys(item.binary)) {\n      if (key.startsWith('Documento')) {\n        newItems.push({\n          json: { fileName: item.binary[key].fileName },\n          binary: { data: item.binary[key] }\n        });\n      }\n    }\n  }\n}\n\nreturn newItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "split-files",
      "name": "Separar Arquivos"
    },
    {
      "parameters": {
        "operation": "upload",
        "driveId": {
          "__rl": true,
          "value": "myDrive",
          "mode": "list"
        },
        "folderId": {
          "__rl": true,
          "value": "COLE_O_ID_DA_PASTA_ENTRADA_AQUI",
          "mode": "id"
        },
        "fileContent": "data",
        "name": "={{ $binary.data.fileName }}",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        440,
        0
      ],
      "id": "google-drive",
      "name": "Google Drive Upload"
    }
  ],
  "connections": {
    "n8n Form Trigger": {
      "main": [
        [
          {
            "node": "Separar Arquivos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Separar Arquivos": {
      "main": [
        [
          {
            "node": "Google Drive Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}